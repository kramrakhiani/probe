# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.env/
.venv/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS Specific
.DS_Store
Thumbs.db

# LaTeX compilation files
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex.gz
docs/*.fls
docs/*.fdb_latexmk
docs/*.xdv

# Note: We are explicitly NOT ignoring the results/ directory 
# or the docs/*.pdf because these are critical artifacts of the PROBE framework.
